OPENROUTER_API_KEY=your_openrouter_api_key
OPENAI_API_KEY=your_openai_api_key  # optional, needed for STT/voice refine
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
ALLOWED_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DB_PATH=./app.db

# Social login (user auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional OAuth client ids (for connect URL generation)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=cross-posting-agent/0.2

# Optional access tokens (if present, publish worker marks as "live")
LINKEDIN_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
REDDIT_ACCESS_TOKEN=

# Publish configs
LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx
LINKEDIN_VERSION=202502
REDDIT_SUBREDDIT=test
INSTAGRAM_IG_USER_ID=
INSTAGRAM_IMAGE_URL=https://example.com/image.jpg
BLOG_PUBLISH_URL=
BLOG_PUBLISH_TOKEN=
